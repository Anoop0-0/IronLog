# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ironlog

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth client ID (from Google Cloud Console) — must match the
# client's VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Used to build password-reset links (e.g. https://app.example.com).
# Defaults to http://localhost:5173 if unset.
CLIENT_URL=http://localhost:5173

# Optional — SMTP credentials for sending password-reset emails.
# If left unset, reset links are logged to the server console instead of
# emailed, so the flow still works end-to-end in local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
